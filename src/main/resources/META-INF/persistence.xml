<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="bibliotheque" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ma.bibliotheque.entities.Utilisateur</class>
        <class>ma.bibliotheque.entities.Client</class>
        <class>ma.bibliotheque.entities.Auteur</class>
        <class>ma.bibliotheque.entities.Categorie</class>
        <class>ma.bibliotheque.entities.Livre</class>
        <class>ma.bibliotheque.entities.Emprunt</class>
        <class>ma.bibliotheque.entities.Operation</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver"   value="oracle.jdbc.OracleDriver"/>
            <property name="jakarta.persistence.jdbc.url"      value="jdbc:oracle:thin:@localhost:1521/XEPDB1"/>
            <property name="jakarta.persistence.jdbc.user"     value="biblio"/>
            <property name="jakarta.persistence.jdbc.password" value="biblio123"/>
            <property name="hibernate.dialect"                 value="org.hibernate.dialect.OracleDialect"/>
            <property name="hibernate.hbm2ddl.auto"            value="validate"/>
            <property name="hibernate.show_sql"                value="false"/>
            <property name="hibernate.format_sql"              value="false"/>
        </properties>
    </persistence-unit>
</persistence>
